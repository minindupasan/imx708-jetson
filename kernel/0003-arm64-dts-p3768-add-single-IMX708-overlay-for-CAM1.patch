From 05895caf252ffb78940dafe6dc06b8989f48fc54 Mon Sep 17 00:00:00 2001
From: minindupasan <minindupasan@gmail.com>
Date: Mon, 28 Sep 2026 21:47:13 +0530
Subject: [PATCH 3/3] arm64: dts: p3768: add single IMX708 overlay for CAM1

The dual-camera overlay registers sensors on both CSI ports. With a
single camera fitted, the probe on the empty port fails with I2C
errors (-121) and can interfere with the fitted one. Add an overlay
that only describes the camera on CAM1 (serial_b, cam_i2cmux i2c@1),
selectable in jetson-io as "Camera IMX708-C".
---
 .../nvidia/t23x/nv-public/overlay/Makefile    |   1 +
 ...tegra234-p3768-camera-rpicam3-imx708-C.dts | 318 ++++++++++++++++++
 2 files changed, 319 insertions(+)
 create mode 100644 hardware/nvidia/t23x/nv-public/overlay/tegra234-p3768-camera-rpicam3-imx708-C.dts

diff --git a/hardware/nvidia/t23x/nv-public/overlay/Makefile b/hardware/nvidia/t23x/nv-public/overlay/Makefile
index 0c5b253..1aba7a3 100644
--- a/hardware/nvidia/t23x/nv-public/overlay/Makefile
+++ b/hardware/nvidia/t23x/nv-public/overlay/Makefile
@@ -76,6 +76,7 @@ dtbo-y += tegra234-p3767-camera-p3768-imx477-C.dtbo
 dtbo-y += tegra234-p3767-camera-p3768-imx477-A.dtbo
 dtbo-y += tegra234-p3740-0002-p3701-0008-csi.dtbo
 dtbo-y += tegra234-p3768-camera-rpicam3-imx708.dtbo
+dtbo-y += tegra234-p3768-camera-rpicam3-imx708-C.dtbo
 
 ifneq ($(dtb-y),)
 dtb-y := $(addprefix $(makefile-path)/,$(dtb-y))
diff --git a/hardware/nvidia/t23x/nv-public/overlay/tegra234-p3768-camera-rpicam3-imx708-C.dts b/hardware/nvidia/t23x/nv-public/overlay/tegra234-p3768-camera-rpicam3-imx708-C.dts
new file mode 100644
index 0000000..11331a7
--- /dev/null
+++ b/hardware/nvidia/t23x/nv-public/overlay/tegra234-p3768-camera-rpicam3-imx708-C.dts
@@ -0,0 +1,318 @@
