From bc77e3d9639d8cb6ab9b597491df87cd1d37e9bf Mon Sep 17 00:00:00 2001
From: minindupasan <minindupasan@gmail.com>
Date: Mon, 28 Sep 2026 21:47:13 +0530
Subject: [PATCH 1/3] media: imx708: fix analogue gain, exposure limit and
 full-res line length

Analogue gain: the IMX708 gain code is 1024 - 1024 / gain, valid from 0
(1x) to 960 (16x). The previous formula used a constant of 516, so a
requested 16x gain produced roughly 1.9x. Clamp the code to 0..960.

Exposure: the integration time must be at least 48 lines shorter than
the frame (as in the Raspberry Pi imx708 driver). Clamp coarse_time to
frame_length - 48 instead of letting the sensor stretch the frame.

Device tree: line_length for the 4608x2592 mode is 7824 in units of
the 297.6 MHz pixel clock declared in pix_clk_hz (15648 pixels at the
sensor's 595.2 MHz). With 4808 the framework computed wrong frame
lengths and the mode ran at 8.6 fps instead of 14.
---
 .../tegra234-p3768-camera-rpicam3-imx708.dts  |  4 ++--
 nvidia-oot/drivers/media/i2c/nv_imx708.c      | 22 ++++++++++++++-----
 nvidia-oot/include/media/imx708.h             |  2 ++
 3 files changed, 20 insertions(+), 8 deletions(-)

diff --git a/hardware/nvidia/t23x/nv-public/overlay/tegra234-p3768-camera-rpicam3-imx708.dts b/hardware/nvidia/t23x/nv-public/overlay/tegra234-p3768-camera-rpicam3-imx708.dts
index 90fd135..a03c591 100644
--- a/hardware/nvidia/t23x/nv-public/overlay/tegra234-p3768-camera-rpicam3-imx708.dts
+++ b/hardware/nvidia/t23x/nv-public/overlay/tegra234-p3768-camera-rpicam3-imx708.dts
@@ -186,7 +186,7 @@
 								pixel_phase = "rggb";
 								csi_pixel_bit_depth = "10";
 								readout_orientation = "90";
-								line_length = "4808";
+								line_length = "7824";
 								inherent_gain = "1";
 								mclk_multiplier = "80";
 								pix_clk_hz = "297600000";
@@ -259,7 +259,7 @@
 								pixel_phase = "rggb";
 								csi_pixel_bit_depth = "10";
 								readout_orientation = "90";
-								line_length = "4808";
+								line_length = "7824";
 								inherent_gain = "1";
 								mclk_multiplier = "80";
 								pix_clk_hz = "297600000";
diff --git a/nvidia-oot/drivers/media/i2c/nv_imx708.c b/nvidia-oot/drivers/media/i2c/nv_imx708.c
index 5d58147..d4d73b1 100644
--- a/nvidia-oot/drivers/media/i2c/nv_imx708.c
+++ b/nvidia-oot/drivers/media/i2c/nv_imx708.c
@@ -174,13 +174,16 @@ static int imx708_set_gain(struct tegracam_device *tc_dev, s64 val)
 
 	dev_dbg(dev, "%s: Setting gain control to: %lld\n", __func__, val);
 
-	/* Gain Formula:
-	   Gain = (IMX708_GAIN_C0 - (IMX708_GAIN_C0 * gain_factor / val))
+	/* Gain Formula (IMX708 datasheet / libcamera):
+	   code = 1024 - 1024 / gain, valid codes 0 (1x) .. 960 (16x)
 	 */
-	gain =
-	    (s16) (IMX708_ANALOG_GAIN_C0 -
-		   (mode->control_properties.gain_factor *
-		    IMX708_ANALOG_GAIN_C0 / val));
+	gain = (s16) (IMX708_ANALOG_GAIN_CODE_MAX + 64 -
+		      ((IMX708_ANALOG_GAIN_CODE_MAX + 64) *
+		       (s64)mode->control_properties.gain_factor / val));
+	if (gain < 0)
+		gain = 0;
+	if (gain > IMX708_ANALOG_GAIN_CODE_MAX)
+		gain = IMX708_ANALOG_GAIN_CODE_MAX;
 
 	dev_dbg(dev, "%s: val: %lld (/%d) [times], gain: %u\n",
 		__func__, val, mode->control_properties.gain_factor, gain);
@@ -260,6 +263,13 @@ static int imx708_set_exposure(struct tegracam_device *tc_dev, s64 val)
 	    / mode->control_properties.exposure_factor
 	    / mode->image_properties.line_length;
 
+	/* The integration time must fit inside the frame. */
+	if (priv->frame_length > IMX708_EXPOSURE_OFFSET &&
+	    coarse_time > priv->frame_length - IMX708_EXPOSURE_OFFSET)
+		coarse_time = priv->frame_length - IMX708_EXPOSURE_OFFSET;
+	if (coarse_time < IMX708_MIN_COARSE_EXPOSURE)
+		coarse_time = IMX708_MIN_COARSE_EXPOSURE;
+
 	dev_dbg(dev, "%s: val: %lld [us], coarse_time: %d [lines]\n",
 		__func__, val, coarse_time);
 
diff --git a/nvidia-oot/include/media/imx708.h b/nvidia-oot/include/media/imx708.h
index fb888d6..da5105f 100644
--- a/nvidia-oot/include/media/imx708.h
+++ b/nvidia-oot/include/media/imx708.h
@@ -25,6 +25,8 @@
 #define IMX708_MIN_GAIN		                (0)
 #define IMX708_MAX_GAIN		                (978)
 #define IMX708_ANALOG_GAIN_C0		        (516)
+#define IMX708_ANALOG_GAIN_CODE_MAX		(960)
+#define IMX708_EXPOSURE_OFFSET			(48)
 #define IMX708_SHIFT_8_BITS			(8)
 #define IMX708_MIN_FRAME_LENGTH		        (256)
 #define IMX708_MAX_FRAME_LENGTH		        (65535)
